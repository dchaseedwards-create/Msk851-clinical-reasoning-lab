function sendPayload(action,caseData){
 if(!IS_CONNECTED||pendingSend||!navigator.onLine)return;
 const frameName='msk851_submission_iframe';let frame=byId(frameName);
 if(!frame){frame=document.createElement('iframe');frame.name=frameName;frame.id=frameName;frame.style.cssText='position:absolute;width:1px;height:1px;border:0;opacity:0;pointer-events:none';frame.title='Background data collection';document.body.appendChild(frame);}
 const data=action==='final'?{...bundle(),action:'final'}:{tool:'MSK 851 Clinical Reasoning Lab',version:'0.9 PILOT',pilot_id:state.pilot_id,started_at:state.started_at,elapsed_minutes:Math.max(0,Math.round((Date.now()-new Date(state.started_at))/60000)),action:'case',case:caseData};
 const form=document.createElement('form');form.action=COLLECTOR_URL;form.method='POST';form.target=frameName;form.acceptCharset='UTF-8';form.style.display='none';
 const nonce=makeId()+makeId();
 for(const [key,value] of Object.entries({payload:JSON.stringify(data),nonce})){const input=document.createElement('input');input.type='hidden';input.name=key;input.value=value;form.appendChild(input);}
 document.body.appendChild(form);
 pendingSend={action,caseId:action==='case'?caseData.case_id:'',nonce,frame,timeout:null};
 pendingSend.timeout=setTimeout(()=>{if(!pendingSend||pendingSend.nonce!==nonce)return;const isFinal=pendingSend.action==='final';pendingSend=null;state.syncWarning='No confirmation received';if(isFinal){state.submission={status:'unconfirmed'};persist();renderDone();}else{persist();refreshSyncStatus();markRetry();}},22000);
 if(action==='final'){state.submission={status:'sending'};persist();renderDone();}else{state.syncWarning='';refreshSyncStatus();}
 try{form.submit();}catch(error){clearTimeout(pendingSend.timeout);pendingSend=null;state.syncWarning='Upload failed';if(action==='final'){state.submission={status:'failed'};persist();renderDone();}else{persist();refreshSyncStatus();markRetry();}}finally{form.remove();}
}
function queueSync(){
