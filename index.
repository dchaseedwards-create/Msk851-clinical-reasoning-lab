window.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&navigator.onLine)queueSync();});
function renderDone(){let all=bundle();let switches=all.cases.filter(c=>c.responses[0]?.choice!==c.responses[1]?.choice).length;let sub=state.submission||{},confirmed=sub.status==='confirmed';let status=confirmed?`<div class="successbox" role="status"><strong>Submission confirmed ✓</strong><p>Your completed session and final feedback were confirmed by the faculty collector. Keep this receipt if you need to verify participation:</p><div class="receipt">${esc(sub.receipt||state.pilot_id)}</div><p class="minihelp">A receipt code can be associated with your responses if you give it to faculty to verify service hours.</p></div>`:sub.status==='sending'?`<div class="note" role="status"><strong>Finishing submission to the faculty response sheet…</strong> Keep this page open until you see confirmation.</div>`:sub.status==='unconfirmed'?`<div class="collectorWarning" role="alert"><strong>Submission not verified.</strong> Your answers remain on this device. Check your connection and retry, or download the backup CSV. Do not assume it was received.</div>`:sub.status==='failed'?`<div class="collectorWarning" role="alert"><strong>Could not confirm collection.</strong> Retry or download a backup CSV. No response has been marked submitted.</div>`:IS_CONNECTED?`<div class="note"><strong>Ready to finish.</strong> Completed cases have been queued for automatic collection. Final submission adds your survey and verifies a complete six-case session.</div>`:`<div class="collectorWarning"><strong>Online collection is not configured.</strong> This file is a faculty preview. Download a CSV backup; do not distribute this file to students until the collector is connected.</div>`;
setRoot(`${decisionBar()}<div class="eyebrow">Pilot complete</div><h2>Thank you for helping us improve this tool.</h2><p>You completed six cases and gave case-by-case feedback. You revised a disposition in <strong>${switches} of 6</strong> cases; that isn't a score.</p>${status}${!confirmed&&IS_CONNECTED?`<div class="finishBtns"><button class="primary" id="sendAgain" ${sub.status==='sending'?'disabled':''}>${sub.status==='sending'?'Sending…':sub.status?'Retry submitting my responses →':'Send my responses to faculty →'}</button></div>`:''}<details class="backupDetails"><summary>Download a backup response file (optional)</summary><p class="minihelp">The CSV stores all six cases, free-text reasoning, pivot decisions, and feedback. If your submission is not confirmed, keep a copy and follow faculty instructions.</p><div class="finishBtns"><button class="secondary" id="csv">↓ Backup CSV</button><button class="secondary" id="json">↓ Backup JSON</button></div></details><div class="field"><label>Your pilot code</label><div class="statusbar"><span class="code">${esc(state.pilot_id)}</span><span class="muted">Do not include your name in clinical responses.</span></div></div><div class="actions"><button class="secondary" id="copy">Copy completion code</button><button class="secondary" id="wipe" ${confirmed?'':'disabled'}>Clear saved responses</button></div><div class="disclaimer">No grade is calculated. The faculty's reference decisions are educational interpretations, not validated diagnostic rules. Results must be reviewed in the context of clinical evidence and patient safety.</div>`);
byId('csv').onclick=()=>download(`MSK851_Pilot_${all.pilot_id}.csv`,makeCSV(),'text/csv;charset=utf-8');byId('json').onclick=()=>download(`MSK851_Pilot_${all.pilot_id}.json`,JSON.stringify(all,null,2),'application/json');if(byId('sendAgain'))byId('sendAgain').onclick=sendToCollector;byId('copy').onclick=async()=>{try{await navigator.clipboard.writeText(state.pilot_id);byId('copy').textContent='Copied ✓'}catch(e){byId('copy').textContent='Copy manually: '+state.pilot_id}};byId('wipe').onclick=()=>{if(confirm('Clear locally saved pilot responses? This cannot be undone.')){try{localStorage.removeItem(LS)}catch(e){}state={pilot_id:makeId(),started_at:new Date().toISOString(),caseIndex:-1,step:0,answers:{},pivots:{},caseFeedback:{},feedback:null,finished:false,submission:null,syncedCases:{},syncWarning:''};render()}};
}
render();if(IS_CONNECTED&&navigator.onLine)setTimeout(queueSync,350);
})();
</script></body></html>
