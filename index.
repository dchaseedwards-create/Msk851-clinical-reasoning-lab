 const next=locallyCompletedCases().find(c=>!state.syncedCases[c.id]);
 if(next)sendPayload('case',{case_id:next.id,case_title:next.title,responses:state.answers[next.id],pivot_predictions:(state.pivots||{})[next.id]||{},case_feedback:state.caseFeedback[next.id]});
 else{state.syncWarning='';refreshSyncStatus();}
}
