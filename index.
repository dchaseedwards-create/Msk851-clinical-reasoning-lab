 let c=cases[state.caseIndex],review=REVIEWS[c.id],answers=state.answers[c.id]||[],first=answers[0],last=answers[1];
 if(!first||!last){state.step=answers.length===1?1:0;persist();render();return}
 state.pivots=state.pivots||{};state.pivots[c.id]=state.pivots[c.id]||{};
 const entries=state.pivots[c.id];
 const cards=review.pivots.map((p,i)=>{
   const prediction=entries[p.id];
   return `<div class="pivot"><div class="pivottitle">What if ${i+1} · Modify one key detail</div><p>${esc(p.change)}</p><div class="predict">${prediction?'Your prediction is recorded:':'Before revealing the faculty reference, predict the safest management pathway:'}</div>${prediction?`<div class="pivotresult"><div><strong>Your prediction:</strong> ${esc(LABELS[prediction]||'Uncertain')}</div><div><strong>Faculty reference:</strong> <span class="refcolor ${p.color}">${esc(LABELS[p.color])}</span></div><p>${esc(p.why)}</p></div>`:`<div class="predchoices" role="group" aria-label="Predict outcome for scenario ${i+1}">${['g','y','o','r','u'].map(k=>`<button type="button" data-pivot="${esc(p.id)}" data-prediction="${k}">${k==='u'?'Not sure':LABELS[k]}</button>`).join('')}</div>`}</div>`
 }).join('');
 setRoot(`${decisionBar()}<div class="eyebrow">CASE ${state.caseIndex+1} / ${cases.length} · FACULTY-GUIDED REVIEW</div><h2>${esc(c.title)} — where did the line move?</h2><p>Your two decisions are locked. This is a <strong>learning debrief</strong>, not a score or a diagnosis. Compare your management actions and how you handled uncertainty.</p><div class="revtop"><div class="mini">Your decisions compared with a faculty reference</div><div class="revrow"><strong>Checkpoint 1</strong><span>Your choice: <strong>${esc(LABELS[first.choice])}</strong> · Confidence ${first.confidence}/5</span></div><p class="textsmall">${esc(review.initial)}</p><div class="revrow"><strong>Checkpoint 2</strong><span>Your choice: <strong>${esc(LABELS[last.choice])}</strong> · Confidence ${last.confidence}/5</span><span>Faculty reference: <span class="refcolor ${review.final}">${esc(LABELS[review.final])}</span></span></div><p>${esc(review.why)}</p></div><div class="revsection"><h3>What would change the disposition?</h3><p class="explainer">Hold the basic case in mind. Each alternate branch changes or clarifies one clinically meaningful part of the situation. Predict the action <strong>before</strong> revealing our faculty interpretation. You may skip a prediction if you need to move on.</p><div class="pivotGrid">${cards}</div><div class="revnotice"><strong>Calibration principle:</strong> A color is a management decision, not a diagnosis or a point-based checklist. Some scenarios remain ambiguous, and no single finding is a universal rule. These counterfactuals assume no other contradictory facts are present. Local pathways and patient-specific context still apply.</div></div><div class="revsection"><h3>30-second case check</h3><p class="explainer">We want to revise weak questions. Which option best describes this case as a learning exercise?</p><div class="pulseOptions" role="group" aria-label="Feedback for this case">${PULSE_OPTIONS.map(([value,label])=>`<button type="button" class="pulseChoice ${state.caseFeedback[c.id]?.flag===value?'chosen':''}" data-pulse="${value}" aria-pressed="${state.caseFeedback[c.id]?.flag===value}">${esc(label)}</button>`).join('')}</div><div class="field"><label for="pulseNote">What exact detail would you change or keep? <span class="muted">(optional, but very helpful)</span></label><textarea id="pulseNote" maxlength="550" style="min-height:76px" placeholder="Example: Case 4 gave away the diagnosis when it said...">${esc(state.caseFeedback[c.id]?.note||'')}</textarea></div><div id="pulseWarning" class="err hide" role="alert"></div></div><div class="revsection"><h3>Common trap in this case</h3><p>${esc(review.trap)}</p></div><div class="actions"><span class="muted">You cannot return to edit either decision.</span><button type="button" class="primary" id="nextcase">${state.caseIndex===cases.length-1?'Continue to student feedback →':`Proceed to Case ${state.caseIndex+2} →`}</button></div>`);
 document.querySelectorAll('[data-pivot]').forEach(button=>button.onclick=()=>{const p=button.dataset.pivot,k=button.dataset.prediction;if(entries[p])return;entries[p]=k;persist();renderReview();});
 document.querySelectorAll('[data-pulse]').forEach(button=>button.onclick=()=>{state.caseFeedback[c.id]=state.caseFeedback[c.id]||{};state.caseFeedback[c.id].flag=button.dataset.pulse;state.caseFeedback[c.id].note=byId('pulseNote').value;persist();renderReview();});
 byId('pulseNote').oninput=()=>{state.caseFeedback[c.id]=state.caseFeedback[c.id]||{};state.caseFeedback[c.id].note=byId('pulseNote').value;persist();};
 byId('nextcase').onclick=()=>{if(!state.caseFeedback[c.id]?.flag){byId('pulseWarning').textContent='Please select one quick case-feedback option before moving on.';byId('pulseWarning').classList.remove('hide');byId('pulseWarning').scrollIntoView({block:'center',behavior:'smooth'});return;}state.caseIndex++;state.step=0;persist();render();queueSync();window.scrollTo({top:0,behavior:'instant'});};
}

function renderSurvey(){let options=[1,2,3,4,5];state.surveyDraft=state.surveyDraft||{};let draft=state.surveyDraft;setRoot(`${decisionBar()}<div class="eyebrow">Six cases complete</div><h2>Tell us what we should fix.</h2><p>We have your clinical decisions and the quick feedback you gave on each case. Just a few closing questions remain.</p><p class="muted">1 = strongly disagree; 5 = strongly agree</p>${Object.keys(questions).map(id=>`<div class="surveyGroup"><div class="scaleHead">${esc(questions[id])}</div><div class="scale">${options.map(n=>`<label><input type="radio" name="${id}" value="${n}" ${Number(draft[id])===n?'checked':''} aria-label="${esc(id)} rating ${n}"> ${n}</label>`).join('')}</div></div>`).join('')}<div class="field"><label for="actionable">Give us ONE actionable piece of feedback. Name a case or feature, describe what you noticed, and what you would change (or why you would keep it). <span class="muted">(required)</span></label><textarea id="actionable" minlength="30" maxlength="1200" placeholder="Case number + specific finding or screen + suggested change and why...">${esc(draft.actionable||'')}</textarea></div><div class="field"><label for="overconfident">Did anything make the correct choice seem more certain than the clinical information justified? <span class="muted">(optional)</span></label><textarea id="overconfident" maxlength="850" style="min-height:70px" placeholder="A phrase, a review, a pivot, or no concern...">${esc(draft.overconfident||'')}</textarea></div><div id="warning" class="err hide" role="alert"></div><div class="actions"><span class="muted">Three ratings and one concrete comment required. Critical feedback is especially useful.</span><button class="primary" id="submit">Finish and prepare my responses →</button></div>`);
function saveSurvey(){state.surveyDraft=state.surveyDraft||{};for(let id in questions){let e=document.querySelector(`input[name="${id}"]:checked`);state.surveyDraft[id]=e?Number(e.value):null}for(let key of ['actionable','overconfident'])state.surveyDraft[key]=byId(key).value;persist()};document.querySelectorAll('input[type="radio"],textarea').forEach(e=>e.addEventListener('change',saveSurvey));document.querySelectorAll('textarea').forEach(e=>e.addEventListener('input',saveSurvey));
byId('submit').onclick=()=>{saveSurvey();for(let id in questions){if(!state.surveyDraft[id]){byId('warning').textContent='Please rate all three statements before finishing.';byId('warning').classList.remove('hide');return}}if((state.surveyDraft.actionable||'').trim().length<30){byId('warning').textContent='Please provide one specific, actionable observation (at least 30 characters). If nothing needs changing, explain what worked well and why.';byId('warning').classList.remove('hide');return;}state.feedback={...state.surveyDraft};state.completed_at=new Date().toISOString();state.finished=true;delete state.surveyDraft;persist();render();if(IS_CONNECTED){setTimeout(queueSync,100);}window.scrollTo({top:0,behavior:'instant'});};}
function bundle(){return {tool:'MSK 851 Clinical Reasoning Lab',version:'0.9 PILOT',set:SET,pilot_id:state.pilot_id,started_at:state.started_at,completed_at:state.completed_at||'',elapsed_minutes:Math.round((new Date(state.completed_at||Date.now())-new Date(state.started_at))/60000),cases:cases.map(c=>({case_id:c.id,case_title:c.title,responses:state.answers[c.id]||[],pivot_predictions:(state.pivots||{})[c.id]||{},case_feedback:state.caseFeedback[c.id]||{}})),survey:state.feedback,disclaimer:'Fictional cases; no names or actual patient data. No automated scoring. Faculty debrief shown between cases.'}}
