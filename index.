window.addEventListener('message',event=>{
 if(!pendingSend||!isAllowedAckOrigin(event.origin))return;
 const d=event.data;
 if(!d||d.source!=='MSK851_COLLECTOR_V09'||d.nonce!==pendingSend.nonce||d.pilot_id!==state.pilot_id||d.action!==pendingSend.action||String(d.case_id||'')!==pendingSend.caseId)return;
