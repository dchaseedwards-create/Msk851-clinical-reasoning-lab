for(const btn of document.querySelectorAll('[data-choice]')){btn.onclick=()=>{choice=btn.dataset.choice;document.querySelectorAll('[data-choice]').forEach(x=>{x.classList.toggle('selected',x.dataset.choice===choice);x.setAttribute('aria-pressed',x.dataset.choice===choice?'true':'false')});saveDraft()};if(btn.dataset.choice===choice){btn.classList.add('selected');btn.setAttribute('aria-pressed','true')}}
