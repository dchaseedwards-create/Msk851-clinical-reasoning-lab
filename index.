 clearTimeout(pendingSend.timeout);pendingSend=null;
 if(d.ok){state.syncWarning='';if(finished){state.submission={status:'confirmed',at:new Date().toISOString(),receipt:String(d.receipt||state.pilot_id)};state.syncedCases=Object.fromEntries(cases.map(c=>[c.id,true]));persist();renderDone();}else{state.syncedCases[id]=true;persist();refreshSyncStatus();setTimeout(queueSync,60);}}
 else{state.syncWarning='Collector could not confirm the save';if(finished){state.submission={status:'failed'};persist();renderDone();}else{persist();refreshSyncStatus();markRetry();}}
});
